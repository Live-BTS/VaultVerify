# ── Database ─────────────────────────────────────────────────────────
# Local dev: SQLite file. Production: Supabase Postgres (see DEPLOY.md).
# Supabase → Project Settings → Database → Connection string (URI).
DATABASE_URL="file:./db/custom.db"
# DATABASE_URL="postgresql://postgres.[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# ── Supabase (optional client-side usage) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Brevo transactional email ────────────────────────────────────────
# When BREVO_API_KEY + BREVO_SENDER_EMAIL are set, emails send for real.
# Without them the app runs in sandbox mode (notifications simulated + logged).
# Guard: recipients on example.com/example.org never send, even when configured.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="VaultVerify"

# ── Portal access codes ──────────────────────────────────────────────
# SUPERADMIN_EMAIL: the inbox that receives the superadmin's one-time login
# codes (OTP). Required for the OTP flow; the static code stays as backup.
SUPERADMIN_EMAIL=""
SUPERADMIN_CODE="change-me-superadmin-code"
RECRUITER_CODE="change-me-recruiter-code"

# ── D4b: ReferenceRequest token encryption (SERVER ONLY) ─────────────
# Required in production. 32 random bytes — generate with:  openssl rand -base64 32
# Never commit the real key, never expose it to the client, never log it.
# Also configured as a Vercel environment variable (all environments).
# Optional rotation window: set REFERENCE_TOKEN_ENCRYPTION_KEY_PREVIOUS to the
# prior key while re-encrypting v1 envelopes (scripts/d4b-backfill.ts --reencrypt),
# then remove it once the re-encrypt run completes (see DEPLOY.md runbook).
REFERENCE_TOKEN_ENCRYPTION_KEY=""
REFERENCE_TOKEN_ENCRYPTION_KEY_PREVIOUS=""
